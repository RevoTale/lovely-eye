{
  "name": "lovely-eye-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "biome check .. && bun --bun run check:boundaries && bun --bun run typecheck && bun --bun run test:unit",
    "check:boundaries": "bun run scripts/check-boundaries.ts",
    "lint": "biome check ..",
    "format": "biome check --write ..",
    "preview": "vite preview",
    "test": "bun --bun run test:unit && bun --bun run test:e2e && bun --bun run test:e2e:base-path && bun --bun run test:e2e:isolation",
    "test:e2e": "playwright test",
    "test:e2e:base-path": "for base_path in / /lovely-eye /tools/lovely-eye; do TEST_BASE_PATH=\"$base_path\" playwright test tests/e2e/runtime-base-path.spec.ts || exit; done",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:isolation": "TEST_MULTI_INSTANCE=true TEST_BASE_PATH=/instance-a playwright test tests/e2e/auth-isolation.spec.ts",
    "test:unit": "bun test tests/unit",
    "typecheck": "bun --bun run tsc && bun --bun run tsc:tracker",
    "tsc": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.unit.json && tsc --noEmit -p tsconfig.tests.json",
    "tsc:tracker": "tsc --noEmit -p ../server/static/tsconfig.json",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.2.12",
    "@tanstack/react-router": "^1.170.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "graphql": "^17.0.2",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.32",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "lightningcss": "^1.33.0",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.1"
  },
  "overrides": {
    "@graphql-codegen/client-preset": "6.1.3",
    "@babel/core": "7.29.7",
    "brace-expansion": "5.0.9",
    "immutable": "5.1.9",
    "js-yaml": "5.3.0",
    "nanoid": "3.3.18",
    "shell-quote": "1.10.0",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "trustedDependencies": [
    "@swc/core"
  ]
}
