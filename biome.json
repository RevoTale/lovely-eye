{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      ".devcontainer/devcontainer.json",
      "dashboard/codegen.ts",
      "dashboard/components.json",
      "dashboard/index.html",
      "dashboard/package.json",
      "dashboard/playwright.config.ts",
      "dashboard/scripts/check-boundaries.ts",
      "dashboard/scripts/report-bundle-size.ts",
      "dashboard/src/**",
      "dashboard/tsconfig.json",
      "dashboard/tsconfig.node.json",
      "dashboard/tsconfig.tests.json",
      "dashboard/tsconfig.unit.json",
      "dashboard/tests/**",
      "dashboard/vite.config.ts",
      "server/e2e/operations/**",
      "server/schema/**",
      "server/static/tracker.ts",
      "server/static/tsconfig.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "jsxQuoteStyle": "single",
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5"
    },
    "jsxRuntime": "transparent"
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    },
    "parser": {
      "allowComments": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noArguments": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 25
          }
        }
      },
      "performance": {
        "noNamespaceImport": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@apollo/client": {
                "importNames": ["gql"],
                "message": "Use .graphql files instead of gql templates."
              },
              "graphql-tag": "Use .graphql files instead of gql templates."
            }
          }
        },
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useThrowOnlyError": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "error",
        "noExplicitAny": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["dashboard/src/**/*.ts", "dashboard/src/**/*.tsx", "server/static/**/*.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 160
              }
            }
          },
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 220
              }
            }
          }
        }
      }
    },
    {
      "includes": ["dashboard/src/shared/api/generated/**", "dashboard/src/app/route-tree.gen.ts"],
      "assist": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["dashboard/src/app/router.tsx", "dashboard/src/app/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useThrowOnlyError": "off"
          }
        }
      }
    },
    {
      "includes": ["dashboard/src/shared/ui/**"],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off"
          }
        }
      }
    }
  ]
}
